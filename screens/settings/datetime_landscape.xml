
<screen>
    <styles>
        <!-- NTP SWITCH MAIN -->
        <style
            name="datetime_land_switch_main"
            bg_color="0x344256"
            bg_opa="100%"
            radius="999"
            pad_all="3"
            border_width="0"
        />

        <!-- NTP SWITCH CHECKED -->
        <style
            name="datetime_land_switch_checked"
            bg_color="0xa52a26"
            bg_opa="100%"
            radius="999"
        />

        <!-- NTP SWITCH KNOB -->
        <style
            name="datetime_land_switch_knob"
            bg_color="0xffffff"
            bg_opa="100%"
            radius="999"
            pad_all="0"
            border_width="0"
            shadow_color="0x000000"
            shadow_opa="25%"
            shadow_width="4"
        />
    </styles>

    <view
        width="480"
        height="320"
        style_bg_color="0x0b111b"
        style_bg_opa="100%"
        style_border_width="0"
        style_radius="0"
        style_pad_all="0"
    >

        <!-- HEADER -->

        <lv_obj
            x="12" y="9"
            width="34" height="34"
            style_bg_color="0x172332"
            style_bg_opa="100%"
            style_border_color="0x29394d"
            style_border_width="1"
            style_radius="9"
            style_pad_all="0"
        />

        <lv_image
            x="17" y="14"
            width="24" height="24"
            src="ui_back"
        />

        <lv_label
            x="56" y="5"
            width="310" height="28"
            text="Ngày giờ và múi giờ"
            style_text_font="be_semibold_20"
            style_text_color="0xffffff"
        />

        <lv_label
            x="57" y="32"
            width="285" height="17"
            text="Đồng bộ và định dạng thời gian"
            style_text_font="be_medium_11"
            style_text_color="0x94a3b8"
        />

        <lv_obj
            x="12" y="53"
            width="456" height="1"
            style_bg_color="0x29394d"
            style_bg_opa="100%"
            style_border_width="0"
            style_pad_all="0"
        />

        <!-- ===================== -->
        <!-- LEFT: NTP SETTINGS -->
        <!-- ===================== -->

        <lv_label
            x="13" y="61"
            width="211" height="19"
            text="ĐỒNG BỘ THỜI GIAN"
            style_text_font="be_semibold_12"
            style_text_color="0x94a3b8"
        />

        <!-- AUTO NTP CARD -->

        <lv_obj
            x="12" y="83"
            width="220" height="76"
            style_bg_color="0x172332"
            style_bg_opa="100%"
            style_border_color="0x29394d"
            style_border_width="1"
            style_radius="11"
            style_pad_all="0"
        />

        <lv_label
            x="22" y="95"
            width="155" height="20"
            text="Tự động qua NTP"
            style_text_font="be_semibold_12"
            style_text_color="0xffffff"
        />

        <lv_label
            x="22" y="122"
            width="186" height="17"
            text="Cập nhật giờ qua Internet"
            style_text_font="be_medium_10"
            style_text_color="0x94a3b8"
        />

        <lv_switch
            name="datetime_ntp_enabled_landscape"
            x="181" y="94"
            width="40" height="22"
            checked="true"
        >
            <style
                name="datetime_land_switch_main"
                selector="main"
            />
            <style
                name="datetime_land_switch_checked"
                selector="indicator|checked"
            />
            <style
                name="datetime_land_switch_knob"
                selector="knob"
            />
        </lv_switch>

        <!-- NTP SERVER -->

        <lv_label
            x="13" y="169"
            width="211" height="19"
            text="MÁY CHỦ THỜI GIAN"
            style_text_font="be_semibold_12"
            style_text_color="0x94a3b8"
        />

        <lv_obj
            x="12" y="191"
            width="220" height="77"
            style_bg_color="0x172332"
            style_bg_opa="100%"
            style_border_color="0x29394d"
            style_border_width="1"
            style_radius="11"
            style_pad_all="0"
        />

        <lv_label
            x="22" y="199"
            width="198" height="19"
            text="Máy chủ NTP"
            style_text_font="be_semibold_12"
            style_text_color="0xffffff"
        />

        <lv_textarea
            name="datetime_ntp_server_landscape"
            x="22" y="224"
            width="200" height="32"
            text="pool.ntp.org"
            style_text_font="be_medium_12"
            style_text_color="0xffffff"
            style_bg_color="0x0f1b2a"
            style_bg_opa="100%"
            style_border_color="0x70403d"
            style_border_width="1"
            style_radius="8"
            style_pad_left="9"
            style_pad_right="9"
            style_pad_top="5"
            style_pad_bottom="0"
        />

        <!-- ===================== -->
        <!-- RIGHT: TIMEZONE -->
        <!-- ===================== -->

        <lv_label
            x="241" y="61"
            width="218" height="19"
            text="MÚI GIỜ VÀ HIỂN THỊ"
            style_text_font="be_semibold_12"
            style_text_color="0x94a3b8"
        />

        <lv_obj
            x="240" y="83"
            width="228" height="96"
            style_bg_color="0x172332"
            style_bg_opa="100%"
            style_border_color="0x29394d"
            style_border_width="1"
            style_radius="11"
            style_pad_all="0"
        />

        <!-- TIMEZONE ROW -->

        <lv_label
            x="251" y="94"
            width="85" height="19"
            text="Múi giờ"
            style_text_font="be_semibold_12"
            style_text_color="0xffffff"
        />

        <lv_label
            x="329" y="94"
            width="105" height="19"
            text="UTC+7"
            style_text_font="be_medium_12"
            style_text_align="right"
            style_text_color="0xe28d88"
        />

        <lv_image
            x="436" y="90"
            width="24" height="24"
            src="ui_next"
        />

        <lv_obj
            x="251" y="122"
            width="206" height="1"
            style_bg_color="0x29394d"
            style_bg_opa="100%"
            style_border_width="0"
            style_pad_all="0"
        />

        <!-- TIME FORMAT ROW -->

        <lv_label
            x="251" y="141"
            width="79" height="19"
            text="Giờ"
            style_text_font="be_semibold_12"
            style_text_color="0xffffff"
        />

        <lv_button
            name="datetime_format_12h_landscape"
            x="325" y="134"
            width="61" height="30"
            style_bg_color="0x233247"
            style_bg_opa="100%"
            style_border_width="0"
            style_radius="8"
            style_shadow_width="0"
            style_pad_all="0"
        >
            <lv_label
                align="center"
                text="12 giờ"
                style_text_font="be_medium_11"
                style_text_color="0x94a3b8"
            />
        </lv_button>

        <lv_button
            name="datetime_format_24h_landscape"
            x="391" y="134"
            width="66" height="30"
            style_bg_color="0xa52a26"
            style_bg_opa="100%"
            style_border_width="0"
            style_radius="8"
            style_shadow_width="0"
            style_pad_all="0"
        >
            <lv_label
                align="center"
                text="24 giờ"
                style_text_font="be_semibold_12"
                style_text_color="0xffffff"
            />
        </lv_button>

        <!-- ===================== -->
        <!-- RIGHT: NTP STATUS -->
        <!-- ===================== -->

        <lv_label
            x="241" y="189"
            width="218" height="19"
            text="TRẠNG THÁI ĐỒNG BỘ"
            style_text_font="be_semibold_12"
            style_text_color="0x94a3b8"
        />

        <lv_obj
            x="240" y="211"
            width="228" height="57"
            style_bg_color="0x121f2d"
            style_bg_opa="100%"
            style_border_color="0x29394d"
            style_border_width="1"
            style_radius="10"
            style_pad_all="0"
        />

        <lv_obj
            x="251" y="227"
            width="7" height="7"
            style_bg_color="0x64748b"
            style_bg_opa="100%"
            style_border_width="0"
            style_radius="4"
            style_pad_all="0"
        />

        <lv_label
            x="264" y="219"
            width="190" height="20"
            text="Chưa kiểm tra NTP"
            style_text_font="be_semibold_12"
            style_text_color="0xffffff"
        />

        <lv_label
            x="264" y="241"
            width="190" height="18"
            text="Giờ mẫu: 10:35:28"
            style_text_font="be_medium_11"
            style_text_color="0x94a3b8"
        />

        <!-- ===================== -->
        <!-- SAVE BUTTON -->
        <!-- ===================== -->

        <lv_button
            name="btn_datetime_save_landscape"
            x="12" y="278"
            width="456" height="30"
            style_bg_color="0xa52a26"
            style_bg_opa="100%"
            style_border_width="0"
            style_radius="9"
            style_shadow_width="0"
            style_pad_all="0"
        >
            <lv_label
                align="center"
                text="Lưu cài đặt thời gian"
                style_text_font="be_semibold_14"
                style_text_color="0xffffff"
            />
        </lv_button>

    </view>
</screen>
