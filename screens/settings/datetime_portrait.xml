
<screen>
    <styles>
        <!-- NTP SWITCH -->
        <style
            name="datetime_switch_main"
            bg_color="0x344256"
            bg_opa="100%"
            radius="999"
            pad_all="3"
            border_width="0"
        />

        <style
            name="datetime_switch_checked"
            bg_color="0xa52a26"
            bg_opa="100%"
            radius="999"
        />

        <style
            name="datetime_switch_knob"
            bg_color="0xffffff"
            bg_opa="100%"
            radius="999"
            pad_all="0"
            border_width="0"
            shadow_color="0x000000"
            shadow_opa="25%"
            shadow_width="4"
        />
    </styles>

    <view
        width="320"
        height="480"
        style_bg_color="0x0b111b"
        style_bg_opa="100%"
        style_border_width="0"
        style_radius="0"
        style_pad_all="0"
    >

        <!-- HEADER -->

        <lv_obj
            x="12" y="12"
            width="36" height="36"
            style_bg_color="0x172332"
            style_bg_opa="100%"
            style_border_color="0x29394d"
            style_border_width="1"
            style_radius="10"
            style_pad_all="0"
        />

        <lv_image
            x="18" y="18"
            width="24" height="24"
            src="ui_back"
        />

        <lv_label
            x="58" y="9"
            width="247" height="28"
            text="Ngày giờ và múi giờ"
            style_text_font="be_semibold_20"
            style_text_color="0xffffff"
        />

        <lv_label
            x="59" y="36"
            width="238" height="17"
            text="Đồng bộ và định dạng thời gian"
            style_text_font="be_medium_11"
            style_text_color="0x94a3b8"
        />

        <lv_obj
            x="12" y="59"
            width="296" height="1"
            style_bg_color="0x29394d"
            style_bg_opa="100%"
            style_border_width="0"
            style_pad_all="0"
        />

        <!-- NTP SECTION -->

        <lv_label
            x="13" y="68"
            width="230" height="19"
            text="ĐỒNG BỘ THỜI GIAN"
            style_text_font="be_semibold_12"
            style_text_color="0x94a3b8"
        />

        <lv_obj
            x="12" y="91"
            width="296" height="66"
            style_bg_color="0x172332"
            style_bg_opa="100%"
            style_border_color="0x29394d"
            style_border_width="1"
            style_radius="11"
            style_pad_all="0"
        />

        <lv_label
            x="24" y="102"
            width="194" height="20"
            text="Tự động qua NTP"
            style_text_font="be_semibold_14"
            style_text_color="0xffffff"
        />

        <lv_label
            x="24" y="126"
            width="213" height="18"
            text="Cập nhật giờ qua Internet"
            style_text_font="be_medium_11"
            style_text_color="0x94a3b8"
        />

        <lv_switch
            name="datetime_ntp_enabled"
            x="252" y="112"
            width="43" height="23"
            checked="true"
        >
            <style
                name="datetime_switch_main"
                selector="main"
            />
            <style
                name="datetime_switch_checked"
                selector="indicator|checked"
            />
            <style
                name="datetime_switch_knob"
                selector="knob"
            />
        </lv_switch>

        <!-- NTP SERVER AND TIMEZONE -->

        <lv_label
            x="13" y="166"
            width="237" height="19"
            text="MÁY CHỦ VÀ MÚI GIỜ"
            style_text_font="be_semibold_12"
            style_text_color="0x94a3b8"
        />

        <lv_obj
            x="12" y="188"
            width="296" height="105"
            style_bg_color="0x172332"
            style_bg_opa="100%"
            style_border_color="0x29394d"
            style_border_width="1"
            style_radius="11"
            style_pad_all="0"
        />

        <!-- NTP SERVER -->

        <lv_label
            x="24" y="196"
            width="218" height="19"
            text="Máy chủ NTP"
            style_text_font="be_semibold_12"
            style_text_color="0xffffff"
        />

        <lv_textarea
            name="datetime_ntp_server"
            x="24" y="218"
            width="272" height="30"
            text="pool.ntp.org"
            style_text_font="be_medium_12"
            style_text_color="0xffffff"
            style_bg_color="0x0f1b2a"
            style_bg_opa="100%"
            style_border_color="0x70403d"
            style_border_width="1"
            style_radius="8"
            style_pad_left="10"
            style_pad_right="10"
            style_pad_top="5"
            style_pad_bottom="0"
        />

        <!-- TIMEZONE DIVIDER -->

        <lv_obj
            x="24" y="256"
            width="272" height="1"
            style_bg_color="0x29394d"
            style_bg_opa="100%"
            style_border_width="0"
            style_pad_all="0"
        />

        <!-- TIMEZONE ROW -->

        <lv_label
            x="24" y="265"
            width="104" height="19"
            text="Múi giờ"
            style_text_font="be_semibold_12"
            style_text_color="0xffffff"
        />

        <lv_label
            x="119" y="265"
            width="151" height="19"
            text="Việt Nam · UTC+7"
            style_text_font="be_medium_11"
            style_text_align="right"
            style_text_color="0xe28d88"
        />

        <lv_image
            x="273" y="261"
            width="24" height="24"
            src="ui_next"
        />

        <!-- TIME FORMAT -->

        <lv_label
            x="13" y="302"
            width="237" height="19"
            text="ĐỊNH DẠNG HIỂN THỊ"
            style_text_font="be_semibold_12"
            style_text_color="0x94a3b8"
        />

        <lv_obj
            x="12" y="324"
            width="296" height="49"
            style_bg_color="0x172332"
            style_bg_opa="100%"
            style_border_color="0x29394d"
            style_border_width="1"
            style_radius="10"
            style_pad_all="0"
        />

        <lv_label
            x="24" y="339"
            width="106" height="19"
            text="Định dạng giờ"
            style_text_font="be_semibold_12"
            style_text_color="0xffffff"
        />

        <!-- 12 HOUR -->

        <lv_button
            name="datetime_format_12h"
            x="148" y="333"
            width="69" height="31"
            style_bg_color="0x233247"
            style_bg_opa="100%"
            style_border_width="0"
            style_radius="8"
            style_shadow_width="0"
            style_pad_all="0"
        >
            <lv_label
                align="center"
                text="12 giờ"
                style_text_font="be_medium_12"
                style_text_color="0x94a3b8"
            />
        </lv_button>

        <!-- 24 HOUR -->

        <lv_button
            name="datetime_format_24h"
            x="223" y="333"
            width="73" height="31"
            style_bg_color="0xa52a26"
            style_bg_opa="100%"
            style_border_width="0"
            style_radius="8"
            style_shadow_width="0"
            style_pad_all="0"
        >
            <lv_label
                align="center"
                text="24 giờ"
                style_text_font="be_semibold_12"
                style_text_color="0xffffff"
            />
        </lv_button>

        <!-- TIME STATUS -->

        <lv_obj
            x="12" y="384"
            width="296" height="47"
            style_bg_color="0x121f2d"
            style_bg_opa="100%"
            style_border_color="0x29394d"
            style_border_width="1"
            style_radius="9"
            style_pad_all="0"
        />

        <lv_obj
            x="23" y="397"
            width="7" height="7"
            style_bg_color="0x64748b"
            style_bg_opa="100%"
            style_border_width="0"
            style_radius="4"
            style_pad_all="0"
        />

        <lv_label
            x="36" y="390"
            width="259" height="19"
            text="Trạng thái đồng bộ NTP"
            style_text_font="be_semibold_12"
            style_text_color="0xffffff"
        />

        <lv_label
            x="36" y="411"
            width="259" height="17"
            text="Chưa kiểm tra · Giờ mẫu 10:35:28"
            style_text_font="be_medium_11"
            style_text_color="0x94a3b8"
        />

        <!-- SAVE BUTTON -->

        <lv_button
            name="btn_datetime_save"
            x="12" y="440"
            width="296" height="30"
            style_bg_color="0xa52a26"
            style_bg_opa="100%"
            style_border_width="0"
            style_radius="10"
            style_shadow_width="0"
            style_pad_all="0"
        >
            <lv_label
                align="center"
                text="Lưu cài đặt thời gian"
                style_text_font="be_semibold_14"
                style_text_color="0xffffff"
            />
        </lv_button>

    </view>
</screen>
