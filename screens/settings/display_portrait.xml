			style_bg_opa="100%"
			style_border_width="0"
			style_radius="8"
			style_shadow_width="0"
			style_pad_all="0"
		>
			<lv_label align="center" text="Ngang" style_text_font="be_medium_12" style_text_color="0x94a3b8" />
