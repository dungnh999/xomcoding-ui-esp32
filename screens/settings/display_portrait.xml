		<lv_label
			x="24"
			y="370"
			width="160"
			height="19"
			text="Tự tắt màn hình"
			style_text_font="be_semibold_12"
			style_text_color="0xffffff"
		/>

		<lv_label
			x="208"
			y="370"
			width="67"
			height="19"
			text="5 phút"
