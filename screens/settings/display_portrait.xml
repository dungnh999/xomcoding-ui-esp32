<screen>
	<styles>
		<!-- BRIGHTNESS SLIDER -->

		<style name="display_slider_main" bg_color="0x29394d" bg_opa="100%" radius="999" border_width="0" pad_all="0" />

		<style name="display_slider_indicator" bg_color="0xa52a26" bg_opa="100%" radius="999" />

		<style
			name="display_slider_knob"
			bg_color="0xffffff"
			bg_opa="100%"
			radius="999"
			pad_all="5"
			border_width="1"
			border_color="0xd1d5db"
			shadow_color="0x000000"
			shadow_opa="30%"
			shadow_width="5"
		/>

		<!-- TOUCH FEEDBACK SWITCH -->

		<style name="display_switch_main" bg_color="0x344256" bg_opa="100%" radius="999" pad_all="3" border_width="0" />

		<style name="display_switch_indicator" bg_color="0xa52a26" bg_opa="100%" radius="999" />

		<style
			name="display_switch_knob"
			bg_color="0xffffff"
			bg_opa="100%"
			radius="999"
			pad_all="0"
			border_width="0"
			shadow_color="0x000000"
			shadow_opa="25%"
			shadow_width="4"
		/>
