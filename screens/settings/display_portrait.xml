		<lv_obj
			x="12"
			y="12"
			width="36"
			height="36"
			style_bg_color="0x172332"
			style_bg_opa="100%"
			style_border_color="0x29394d"
			style_border_width="1"
			style_radius="10"
			style_pad_all="0"
		/>

		<lv_image x="18" y="18" width="24" height="24" src="ui_back" />

		<lv_label
			x="58"
			y="9"
			width="244"
			height="28"
