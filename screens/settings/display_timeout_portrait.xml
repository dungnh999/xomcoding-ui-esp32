        <lv_button
            name="btn_display_timeout_cancel"
            x="12" y="439"
            width="140" height="32"
            style_bg_color="0x172332"
            style_bg_opa="100%"
            style_border_color="0x29394d"
            style_border_width="1"
            style_radius="9"
            style_shadow_width="0"
            style_pad_all="0"
