
<screen>
    <view
        width="320"
        height="480"
        style_bg_color="0x0b111b"
        style_bg_opa="100%"
        style_border_width="0"
        style_radius="0"
        style_pad_all="0"
    >

        <!-- HEADER -->

        <lv_obj
            x="12" y="12"
            width="36" height="36"
            style_bg_color="0x172332"
            style_bg_opa="100%"
            style_border_color="0x29394d"
            style_border_width="1"
            style_radius="10"
            style_pad_all="0"
        />

        <lv_image
            x="18" y="18"
            width="24" height="24"
            src="ui_back"
        />

        <lv_label
            x="58" y="9"
            width="248" height="28"
            text="Khôi phục cài đặt"
            style_text_font="be_semibold_20"
            style_text_color="0xffffff"
        />

        <lv_label
            x="59" y="36"
            width="238" height="17"
            text="Xác nhận đưa thiết bị về mặc định"
            style_text_font="be_medium_11"
            style_text_color="0x94a3b8"
        />

        <lv_obj
            x="12" y="59"
            width="296" height="1"
            style_bg_color="0x29394d"
            style_bg_opa="100%"
            style_border_width="0"
            style_pad_all="0"
        />

        <!-- DEVICE SECTION -->

        <lv_label
            x="13" y="68"
            width="250" height="19"
            text="THIẾT BỊ"
            style_text_font="be_semibold_12"
            style_text_color="0x94a3b8"
        />

        <lv_obj
            x="12" y="90"
            width="296" height="65"
            style_bg_color="0x172332"
            style_bg_opa="100%"
            style_border_color="0x29394d"
            style_border_width="1"
            style_radius="11"
            style_pad_all="0"
        />

        <lv_obj
            x="23" y="102"
            width="40" height="40"
            style_bg_color="0x39272a"
            style_bg_opa="100%"
            style_border_width="0"
            style_radius="10"
            style_pad_all="0"
        />

        <lv_label
            x="23" y="108"
            width="40" height="40"
            text="S3"
            style_text_font="be_semibold_16"
            style_text_align="center"
            style_text_color="0xe28d88"
        />

        <lv_label
            x="73" y="99"
            width="219" height="21"
            text="Xóm Coding ESP32-S3"
            style_text_font="be_semibold_14"
            style_text_color="0xffffff"
        />

        <lv_label
            x="73" y="125"
            width="219" height="18"
            text="Khôi phục cấu hình mặc định"
            style_text_font="be_medium_11"
            style_text_color="0x94a3b8"
        />

        <!-- WARNING SECTION -->

        <lv_label
            x="13" y="164"
            width="250" height="19"
            text="CẢNH BÁO KHÔI PHỤC"
            style_text_font="be_semibold_12"
            style_text_color="0x94a3b8"
        />

        <lv_obj
            x="12" y="186"
            width="296" height="113"
            style_bg_color="0x39272a"
            style_bg_opa="100%"
            style_border_color="0x70403d"
            style_border_width="1"
            style_radius="11"
            style_pad_all="0"
        />

        <lv_obj
            x="23" y="198"
            width="3" height="88"
            style_bg_color="0xe28d88"
            style_bg_opa="100%"
            style_border_width="0"
            style_radius="2"
            style_pad_all="0"
        />

        <lv_label
            x="35" y="192"
            width="258" height="20"
            text="Dữ liệu cấu hình sẽ bị xóa"
            style_text_font="be_semibold_14"
            style_text_color="0xffffff"
        />

        <lv_label
            x="35" y="220"
            width="257" height="18"
            text="Wi-Fi và mật khẩu đã lưu"
            style_text_font="be_medium_11"
            style_text_color="0xe2e8f0"
        />

        <lv_label
            x="35" y="241"
            width="257" height="18"
            text="Cấu hình NAS, API và đồng bộ"
            style_text_font="be_medium_11"
            style_text_color="0xe2e8f0"
        />

        <lv_label
            x="35" y="262"
            width="257" height="18"
            text="Các tùy chọn đã cá nhân hóa"
            style_text_font="be_medium_11"
            style_text_color="0xe2e8f0"
        />

        <!-- CONFIRMATION -->

        <lv_label
            x="13" y="309"
            width="250" height="19"
            text="XÁC NHẬN THAO TÁC"
            style_text_font="be_semibold_12"
            style_text_color="0x94a3b8"
        />

        <lv_obj
            x="12" y="331"
            width="296" height="91"
            style_bg_color="0x172332"
            style_bg_opa="100%"
            style_border_color="0x29394d"
            style_border_width="1"
            style_radius="11"
            style_pad_all="0"
        />

        <lv_label
            x="24" y="340"
            width="268" height="19"
            text="Bạn chắc chắn muốn khôi phục?"
            style_text_font="be_semibold_12"
            style_text_color="0xffffff"
        />

        <lv_label
            x="24" y="360"
            width="268" height="17"
            text="Thao tác có thể không hoàn tác."
            style_text_font="be_medium_10"
            style_text_color="0x94a3b8"
        />

        <!-- CHECKBOX REAL LVGL WIDGET -->

        <lv_checkbox
            name="factory_reset_acknowledge"
            x="24" y="386"
            text="Tôi hiểu dữ liệu sẽ bị xóa"
            checked="false"
            style_text_font="be_medium_11"
            style_text_color="0xe2e8f0"
            style_pad_column="8"
        />

        <!-- CANCEL BUTTON -->

        <lv_button
            name="btn_factory_reset_cancel"
            x="12" y="432"
            width="140" height="38"
            style_bg_color="0x172332"
            style_bg_opa="100%"
            style_border_color="0x29394d"
            style_border_width="1"
            style_radius="10"
            style_shadow_width="0"
            style_pad_all="0"
        >
            <lv_label
                align="center"
                text="Hủy"
                style_text_font="be_semibold_14"
                style_text_color="0xe2e8f0"
            />
        </lv_button>

        <!-- FACTORY RESET BUTTON -->

        <lv_button
            name="btn_factory_reset_confirm"
            x="160" y="432"
            width="148" height="38"
            style_bg_color="0xa52a26"
            style_bg_opa="100%"
            style_border_width="0"
            style_radius="10"
            style_shadow_width="0"
            style_pad_all="0"
        >
            <lv_label
                align="center"
                text="Khôi phục"
                style_text_font="be_semibold_14"
                style_text_color="0xffffff"
            />
        </lv_button>

    </view>
</screen>
