
<screen>
    <styles>
        <!-- Checkbox 16x16 -->
        <style
            name="wifi_password_land_checkbox"
            width="16"
            height="16"
            radius="4"
            border_width="1"
            border_color="0x526174"
            bg_color="0x101b2b"
            bg_opa="100%"
        />

        <!-- Xom Coding selected state -->
        <style
            name="wifi_password_land_checked"
            bg_color="0xa52a26"
            border_color="0xa52a26"
        />
    </styles>

    <view
        width="480" height="320"
        style_bg_color="0x0b111b"
        style_bg_opa="100%"
        style_border_width="0"
        style_radius="0"
        style_pad_all="0"
    >

        <!-- HEADER -->

        <lv_obj
            x="12" y="9" width="34" height="34"
            style_bg_color="0x172332"
            style_bg_opa="100%"
            style_border_color="0x29394d"
            style_border_width="1"
            style_radius="9"
            style_pad_all="0"
        />

        <lv_image
            x="17" y="14"
            width="24" height="24"
            src="ui_back"
        />

        <lv_label
            x="56" y="5" width="250" height="28"
            text="Kết nối Wi-Fi"
            style_text_font="be_semibold_20"
            style_text_color="0xffffff"
        />

        <lv_label
            x="57" y="32" width="280" height="17"
            text="Nhập mật khẩu mạng đã chọn"
            style_text_font="be_medium_11"
            style_text_color="0x94a3b8"
        />

        <lv_obj
            x="12" y="53" width="456" height="1"
            style_bg_color="0x29394d"
            style_bg_opa="100%"
            style_border_width="0"
            style_pad_all="0"
        />

        <!-- LEFT COLUMN -->

        <lv_label
            x="13" y="61" width="210" height="19"
            text="MẠNG ĐÃ CHỌN"
            style_text_font="be_semibold_12"
            style_text_color="0x94a3b8"
        />

        <lv_obj
            x="12" y="84" width="220" height="112"
            style_bg_color="0x172332"
            style_bg_opa="100%"
            style_border_color="0x29394d"
            style_border_width="1"
            style_radius="11"
            style_pad_all="0"
        />

        <lv_obj
            x="22" y="95" width="39" height="39"
            style_bg_color="0x213247"
            style_bg_opa="100%"
            style_border_width="0"
            style_radius="9"
            style_pad_all="0"
        />

        <lv_image
            x="28" y="101"
            width="28" height="28"
            src="boot_icon_wifi"
        />

        <lv_label
            x="69" y="95" width="151" height="22"
            text="Home_Network"
            style_text_font="be_semibold_14"
            style_text_color="0xffffff"
        />

        <lv_label
            x="69" y="118" width="151" height="18"
            text="Tín hiệu tốt · -55 dBm"
            style_text_font="be_medium_10"
            style_text_color="0x34d399"
        />

        <lv_obj
            x="22" y="143" width="200" height="1"
            style_bg_color="0x29394d"
            style_bg_opa="100%"
            style_border_width="0"
            style_pad_all="0"
        />

        <lv_label
            x="22" y="150" width="130" height="18"
            text="Loại bảo mật"
            style_text_font="be_medium_11"
            style_text_color="0x94a3b8"
        />

        <lv_label
            x="147" y="150" width="75" height="18"
            text="WPA2"
            style_text_font="be_semibold_12"
            style_text_align="right"
            style_text_color="0x34d399"
        />

        <lv_label
            x="22" y="174" width="198" height="17"
            text="Yêu cầu mật khẩu để kết nối"
            style_text_font="be_medium_10"
            style_text_color="0x94a3b8"
        />

        <!-- LEFT NOTICE -->

        <lv_obj
            x="12" y="205" width="220" height="53"
            style_bg_color="0x121f2d"
            style_bg_opa="100%"
            style_border_color="0x29394d"
            style_border_width="1"
            style_radius="10"
            style_pad_all="0"
        />

        <lv_obj
            x="22" y="214" width="3" height="35"
            style_bg_color="0xa52a26"
            style_bg_opa="100%"
            style_border_width="0"
            style_radius="2"
            style_pad_all="0"
        />

        <lv_label
            x="33" y="210" width="188" height="18"
            text="Lưu ý kết nối"
            style_text_font="be_semibold_12"
            style_text_color="0xffffff"
        />

        <lv_label
            x="33" y="230" width="187" height="16"
            text="Chỉ hỗ trợ Wi-Fi 2.4 GHz."
            style_text_font="be_medium_10"
            style_text_color="0x94a3b8"
        />

        <!-- RIGHT COLUMN -->

        <lv_label
            x="241" y="61" width="225" height="19"
            text="XÁC THỰC KẾT NỐI"
            style_text_font="be_semibold_12"
            style_text_color="0x94a3b8"
        />

        <lv_obj
            x="240" y="84" width="228" height="174"
            style_bg_color="0x172332"
            style_bg_opa="100%"
            style_border_color="0x29394d"
            style_border_width="1"
            style_radius="11"
            style_pad_all="0"
        />

        <lv_label
            x="251" y="95" width="205" height="19"
            text="Mật khẩu Wi-Fi"
            style_text_font="be_semibold_12"
            style_text_color="0xe2e8f0"
        />

        <!-- PASSWORD INPUT -->

        <lv_textarea
            name="input_wifi_password_landscape"
            x="251" y="120"
            width="206" height="39"
            text=""
            style_text_font="be_medium_14"
            style_text_color="0xffffff"
            style_bg_color="0x0f1b2a"
            style_bg_opa="100%"
            style_border_color="0x70403d"
            style_border_width="1"
            style_radius="9"
            style_pad_left="10"
            style_pad_right="10"
            style_pad_top="8"
            style_pad_bottom="0"
        />

        <!-- SMALL CHECKBOX -->

        <lv_checkbox
            name="checkbox_show_wifi_password_landscape"
            x="251" y="171"
            text="Hiện mật khẩu"
            checked="false"
            style_text_font="be_medium_12"
            style_text_color="0xe2e8f0"
            style_pad_column="7"
        >
            <style
                name="wifi_password_land_checkbox"
                selector="indicator"
            />
            <style
                name="wifi_password_land_checked"
                selector="checked|indicator"
            />
        </lv_checkbox>

        <lv_obj
            x="251" y="201" width="206" height="1"
            style_bg_color="0x29394d"
            style_bg_opa="100%"
            style_border_width="0"
            style_pad_all="0"
        />

        <lv_label
            x="251" y="210" width="203" height="17"
            text="Nhập đúng mật khẩu mạng."
            style_text_font="be_medium_11"
            style_text_color="0xe2e8f0"
        />

        <lv_label
            x="251" y="231" width="203" height="16"
            text="WPA2: thường từ 8 ký tự."
            style_text_font="be_medium_10"
            style_text_color="0x94a3b8"
        />

        <!-- BOTTOM ACTIONS -->

        <lv_button
            name="btn_wifi_password_cancel_landscape"
            x="12" y="270"
            width="220" height="38"
            style_bg_color="0x172332"
            style_bg_opa="100%"
            style_border_color="0x29394d"
            style_border_width="1"
            style_radius="10"
            style_shadow_width="0"
            style_pad_all="0"
        >
            <lv_label
                align="center"
                text="Hủy"
                style_text_font="be_semibold_14"
                style_text_color="0xe2e8f0"
            />
        </lv_button>

        <lv_button
            name="btn_wifi_password_connect_landscape"
            x="240" y="270"
            width="228" height="38"
            style_bg_color="0xa52a26"
            style_bg_opa="100%"
            style_border_width="0"
            style_radius="10"
            style_shadow_width="0"
            style_pad_all="0"
        >
            <lv_label
                align="center"
                text="Kết nối Wi-Fi"
                style_text_font="be_semibold_14"
                style_text_color="0xffffff"
            />
        </lv_button>

    </view>
</screen>
