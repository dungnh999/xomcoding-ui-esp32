
<screen>
    <styles>
        <!-- Checkbox indicator: 16x16 -->
        <style
            name="wifi_checkbox_small"
            width="16"
            height="16"
            radius="4"
            border_width="1"
            border_color="0x526174"
            bg_color="0x101b2b"
            bg_opa="100%"
        />

        <!-- Xom Coding checkbox checked -->
        <style
            name="wifi_checkbox_checked"
            bg_color="0xa52a26"
            border_color="0xa52a26"
        />
    </styles>

    <view
        width="320" height="480"
        style_bg_color="0x0b111b"
        style_bg_opa="100%"
        style_border_width="0"
        style_radius="0"
        style_pad_all="0"
    >

        <!-- HEADER -->

        <lv_obj
            x="12" y="12" width="36" height="36"
            style_bg_color="0x172332"
            style_bg_opa="100%"
            style_border_color="0x29394d"
            style_border_width="1"
            style_radius="10"
            style_pad_all="0"
        />

        <lv_image
            x="18" y="18"
            width="24" height="24"
            src="ui_back"
        />

        <lv_label
            x="58" y="9" width="242" height="28"
            text="Kết nối Wi-Fi"
            style_text_font="be_semibold_20"
            style_text_color="0xffffff"
        />

        <lv_label
            x="59" y="36" width="240" height="17"
            text="Nhập mật khẩu mạng đã chọn"
            style_text_font="be_medium_11"
            style_text_color="0x94a3b8"
        />

        <lv_obj
            x="12" y="59" width="296" height="1"
            style_bg_color="0x29394d"
            style_bg_opa="100%"
            style_border_width="0"
            style_pad_all="0"
        />

        <!-- SELECTED NETWORK -->

        <lv_label
            x="13" y="68" width="220" height="19"
            text="MẠNG ĐÃ CHỌN"
            style_text_font="be_semibold_12"
            style_text_color="0x94a3b8"
        />

        <lv_obj
            x="12" y="92" width="296" height="84"
            style_bg_color="0x172332"
            style_bg_opa="100%"
            style_border_color="0x29394d"
            style_border_width="1"
            style_radius="12"
            style_pad_all="0"
        />

        <lv_obj
            x="22" y="103" width="42" height="42"
            style_bg_color="0x213247"
            style_bg_opa="100%"
            style_border_width="0"
            style_radius="10"
            style_pad_all="0"
        />

        <lv_image
            x="29" y="110"
            width="28" height="28"
            src="boot_icon_wifi"
        />

        <lv_label
            x="74" y="101"
            width="194" height="22"
            text="Home_Network"
            style_text_font="be_semibold_14"
            style_text_color="0xffffff"
        />

        <lv_label
            x="74" y="124"
            width="185" height="18"
            text="Tín hiệu tốt · -55 dBm"
            style_text_font="be_medium_11"
            style_text_color="0x34d399"
        />

        <lv_obj
            x="22" y="149" width="274" height="1"
            style_bg_color="0x29394d"
            style_bg_opa="100%"
            style_border_width="0"
            style_pad_all="0"
        />

        <lv_label
            x="24" y="153"
            width="166" height="18"
            text="Bảo mật WPA2"
            style_text_font="be_medium_11"
            style_text_color="0x94a3b8"
        />

        <lv_obj
            x="232" y="152" width="63" height="19"
            style_bg_color="0x24372f"
            style_bg_opa="100%"
            style_border_width="0"
            style_radius="6"
            style_pad_all="0"
        />

        <lv_label
            x="232" y="153"
            width="63" height="17"
            text="Bảo mật"
            style_text_font="be_medium_10"
            style_text_align="center"
            style_text_color="0x34d399"
        />

        <!-- PASSWORD SECTION -->

        <lv_label
            x="13" y="186" width="245" height="19"
            text="XÁC THỰC KẾT NỐI"
            style_text_font="be_semibold_12"
            style_text_color="0x94a3b8"
        />

        <lv_obj
            x="12" y="210" width="296" height="132"
            style_bg_color="0x172332"
            style_bg_opa="100%"
            style_border_color="0x29394d"
            style_border_width="1"
            style_radius="12"
            style_pad_all="0"
        />

        <lv_label
            x="24" y="219"
            width="220" height="19"
            text="Mật khẩu Wi-Fi"
            style_text_font="be_semibold_12"
            style_text_color="0xe2e8f0"
        />

        <!-- PASSWORD INPUT -->

        <lv_textarea
            name="input_wifi_password"
            x="24" y="245"
            width="272" height="39"
            text=""
            style_text_font="be_medium_14"
            style_text_color="0xffffff"
            style_bg_color="0x0f1b2a"
            style_bg_opa="100%"
            style_border_color="0x70403d"
            style_border_width="1"
            style_radius="9"
            style_pad_left="11"
            style_pad_right="11"
            style_pad_top="8"
            style_pad_bottom="0"
        />

        <!-- SHOW PASSWORD CHECKBOX -->

        <lv_checkbox
            name="checkbox_show_wifi_password"
            x="24"
            y="299"
            text="Hiện mật khẩu"
            checked="false"
            style_text_font="be_medium_12"
            style_text_color="0xe2e8f0"
            style_pad_column="7"
        >
            <style
                name="wifi_checkbox_small"
                selector="indicator"
            />
            <style
                name="wifi_checkbox_checked"
                selector="checked|indicator"
            />
        </lv_checkbox>

        <lv_label
            x="24" y="321"
            width="272" height="16"
            text="Mật khẩu thường có ít nhất 8 ký tự."
            style_text_font="be_medium_10"
            style_text_color="0x94a3b8"
        />

        <!-- INFORMATION PANEL -->

        <lv_obj
            x="12" y="352" width="296" height="67"
            style_bg_color="0x121f2d"
            style_bg_opa="100%"
            style_border_color="0x29394d"
            style_border_width="1"
            style_radius="11"
            style_pad_all="0"
        />

        <lv_obj
            x="23" y="363" width="3" height="43"
            style_bg_color="0xa52a26"
            style_bg_opa="100%"
            style_border_width="0"
            style_radius="2"
            style_pad_all="0"
        />

        <lv_label
            x="35" y="360"
            width="260" height="19"
            text="Lưu ý kết nối"
            style_text_font="be_semibold_12"
            style_text_color="0xffffff"
        />

        <lv_label
            x="35" y="380"
            width="255" height="17"
            text="ESP32-S3 chỉ hỗ trợ Wi-Fi 2.4 GHz."
            style_text_font="be_medium_11"
            style_text_color="0x94a3b8"
        />

        <lv_label
            x="35" y="398"
            width="255" height="16"
            text="Chọn đúng mạng và mật khẩu."
            style_text_font="be_medium_10"
            style_text_color="0x94a3b8"
        />

        <!-- BOTTOM BUTTONS -->

        <lv_button
            name="btn_wifi_password_cancel"
            x="12" y="432"
            width="140" height="38"
            style_bg_color="0x172332"
            style_bg_opa="100%"
            style_border_color="0x29394d"
            style_border_width="1"
            style_radius="10"
            style_shadow_width="0"
            style_pad_all="0"
        >
            <lv_label
                align="center"
                text="Hủy"
                style_text_font="be_semibold_14"
                style_text_color="0xe2e8f0"
            />
        </lv_button>

        <lv_button
            name="btn_wifi_password_connect"
            x="160" y="432"
            width="148" height="38"
            style_bg_color="0xa52a26"
            style_bg_opa="100%"
            style_border_width="0"
            style_radius="10"
            style_shadow_width="0"
            style_pad_all="0"
        >
            <lv_label
                align="center"
                text="Kết nối"
                style_text_font="be_semibold_14"
                style_text_color="0xffffff"
            />
        </lv_button>

    </view>
</screen>
