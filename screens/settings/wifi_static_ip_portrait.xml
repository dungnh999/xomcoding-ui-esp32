
<screen>
    <view width="320" height="480"
          style_bg_color="0x0b111b"
          style_bg_opa="100%"
          style_border_width="0"
          style_radius="0"
          style_pad_all="0">

        <!-- ========================= -->
        <!-- HEADER -->
        <!-- ========================= -->

        <lv_obj
            x="12" y="12" width="36" height="36"
            style_bg_color="0x172332"
            style_bg_opa="100%"
            style_border_color="0x29394d"
            style_border_width="1"
            style_radius="10"
            style_pad_all="0"
        />

        <lv_image
            x="18" y="18" width="24" height="24"
            src="ui_back"
        />

        <lv_label
            x="58" y="9" width="240" height="28"
            text="Cấu hình IP tĩnh"
            style_text_font="be_semibold_20"
            style_text_color="0xffffff"
        />

        <lv_label
            x="59" y="36" width="230" height="17"
            text="Thiết lập mạng thủ công"
            style_text_font="be_medium_11"
            style_text_color="0x94a3b8"
        />

        <lv_obj
            x="12" y="59" width="296" height="1"
            style_bg_color="0x29394d"
            style_bg_opa="100%"
            style_border_width="0"
            style_pad_all="0"
        />

        <!-- ========================= -->
        <!-- CONNECTED NETWORK -->
        <!-- ========================= -->

        <lv_obj
            x="12" y="68" width="296" height="64"
            style_bg_color="0x172332"
            style_bg_opa="100%"
            style_border_color="0x29394d"
            style_border_width="1"
            style_radius="11"
            style_pad_all="0"
        />

        <lv_obj
            x="22" y="81" width="38" height="38"
            style_bg_color="0x213247"
            style_bg_opa="100%"
            style_border_width="0"
            style_radius="9"
            style_pad_all="0"
        />

        <lv_image
            x="27" y="86" width="28" height="28"
            src="boot_icon_wifi"
        />

        <lv_label
            x="70" y="76" width="167" height="19"
            text="XomCoding_5G"
            style_text_font="be_semibold_14"
            style_text_color="0xffffff"
        />

        <lv_label
            x="70" y="100" width="175" height="18"
            text="Cấu hình IP thủ công"
            style_text_font="be_medium_11"
            style_text_color="0x94a3b8"
        />

        <!-- STATIC IP BADGE -->

        <lv_obj
            x="244" y="88" width="52" height="24"
            style_bg_color="0x39272a"
            style_bg_opa="100%"
            style_border_width="0"
            style_radius="7"
            style_pad_all="0"
        />

        <lv_label
            x="244" y="91" width="52" height="19"
            text="IP tĩnh"
            style_text_font="be_semibold_12"
            style_text_align="center"
            style_text_color="0xe28d88"
        />

        <!-- ========================= -->
        <!-- NETWORK SETTINGS -->
        <!-- ========================= -->

        <lv_label
            x="13" y="143" width="260" height="19"
            text="THÔNG SỐ MẠNG"
            style_text_font="be_semibold_12"
            style_text_color="0x94a3b8"
        />

        <!-- RESIZED INPUT PANEL -->

        <lv_obj
            x="12" y="166" width="296" height="246"
            style_bg_color="0x172332"
            style_bg_opa="100%"
            style_border_color="0x29394d"
            style_border_width="1"
            style_radius="12"
            style_pad_all="0"
        />

        <!-- IP ADDRESS -->

        <lv_label
            x="24" y="174" width="180" height="19"
            text="Địa chỉ IP"
            style_text_font="be_semibold_12"
            style_text_color="0xe2e8f0"
        />

        <lv_textarea
            name="input_static_ip"
            x="24" y="197" width="272" height="31"
            text="192.168.1.105"
            style_text_font="be_medium_12"
            style_text_color="0xffffff"
            style_bg_color="0x0f1b2a"
            style_bg_opa="100%"
            style_border_color="0x70403d"
            style_border_width="1"
            style_radius="8"
            style_pad_left="10"
            style_pad_right="10"
            style_pad_top="5"
            style_pad_bottom="0"
        />

        <!-- GATEWAY -->

        <lv_label
            x="24" y="233" width="180" height="19"
            text="Gateway"
            style_text_font="be_semibold_12"
            style_text_color="0xe2e8f0"
        />

        <lv_textarea
            name="input_static_gateway"
            x="24" y="256" width="272" height="31"
            text="192.168.1.1"
            style_text_font="be_medium_12"
            style_text_color="0xffffff"
            style_bg_color="0x0f1b2a"
            style_bg_opa="100%"
            style_border_color="0x29394d"
            style_border_width="1"
            style_radius="8"
            style_pad_left="10"
            style_pad_right="10"
            style_pad_top="5"
            style_pad_bottom="0"
        />

        <!-- SUBNET MASK -->

        <lv_label
            x="24" y="292" width="180" height="19"
            text="Subnet Mask"
            style_text_font="be_semibold_12"
            style_text_color="0xe2e8f0"
        />

        <lv_textarea
            name="input_static_subnet"
            x="24" y="315" width="272" height="31"
            text="255.255.255.0"
            style_text_font="be_medium_12"
            style_text_color="0xffffff"
            style_bg_color="0x0f1b2a"
            style_bg_opa="100%"
            style_border_color="0x29394d"
            style_border_width="1"
            style_radius="8"
            style_pad_left="10"
            style_pad_right="10"
            style_pad_top="5"
            style_pad_bottom="0"
        />

        <!-- DNS -->

        <lv_label
            x="24" y="351" width="180" height="19"
            text="DNS"
            style_text_font="be_semibold_12"
            style_text_color="0xe2e8f0"
        />

        <lv_textarea
            name="input_static_dns"
            x="24" y="374" width="272" height="31"
            text="1.1.1.1"
            style_text_font="be_medium_12"
            style_text_color="0xffffff"
            style_bg_color="0x0f1b2a"
            style_bg_opa="100%"
            style_border_color="0x29394d"
            style_border_width="1"
            style_radius="8"
            style_pad_left="10"
            style_pad_right="10"
            style_pad_top="5"
            style_pad_bottom="0"
        />

        <!-- ========================= -->
        <!-- INFORMATION -->
        <!-- ========================= -->

        <lv_label
            x="15" y="416" width="290" height="17"
            text="Kiểm tra IP hợp lệ trước khi lưu."
            style_text_font="be_medium_10"
            style_text_color="0x94a3b8"
        />

        <!-- ========================= -->
        <!-- BOTTOM BUTTONS -->
        <!-- ========================= -->

        <!-- CANCEL -->

        <lv_button
            name="btn_static_ip_cancel"
            x="12" y="435" width="140" height="35"
            style_bg_color="0x172332"
            style_bg_opa="100%"
            style_border_color="0x29394d"
            style_border_width="1"
            style_radius="10"
            style_shadow_width="0"
            style_pad_all="0"
        >
            <lv_label
                align="center"
                text="Hủy"
                style_text_font="be_semibold_14"
                style_text_color="0xe2e8f0"
            />
        </lv_button>

        <!-- SAVE -->

        <lv_button
            name="btn_static_ip_save"
            x="160" y="435" width="148" height="35"
            style_bg_color="0xa52a26"
            style_bg_opa="100%"
            style_border_width="0"
            style_radius="10"
            style_shadow_width="0"
            style_pad_all="0"
        >
            <lv_label
                align="center"
                text="Lưu cấu hình"
                style_text_font="be_semibold_14"
                style_text_color="0xffffff"
            />
        </lv_button>

    </view>
</screen>
